{
  "appId": "co.za.skootlink.app",
  "appName": "Skootlink",
  "webDir": "dist",
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "Browser": {
      "presentationStyle": "popover"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": false
    },
    "SafeArea": {
      "statusBarStyle": "DARK"
    },
    "SystemBars": {
      "insetsHandling": "disable"
    }
  }
}